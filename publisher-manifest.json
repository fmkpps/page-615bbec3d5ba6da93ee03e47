.85rem;letter-spacing: 0.05em}\n.btn:hover {background-color: #962e21}\n.annual-note {font-size: 0.85rem;color: #666;margin-top: 0.5rem}\n.faq-list {list-style: none}\n.faq-item {border: 2px dashed #b83a2b;padding: 1.5rem;margin-bottom: 1rem;background-color: #fff}\n.faq-question {font-weight: 700;color: #b83a2b;margin-bottom: 0.5rem;font-size: 1.1rem}\n.faq-answer {color: #444}\nfooter {border-top: 2px dashed #b83a2b;padding-top: 2rem;margin-top: 4rem;font-size: 0.85rem;color: #666;display: flex;justify-content: space-between;flex-wrap: wrap;gap: 1rem}\nfooter a {color: #b83a2b;text-decoration: none}\n@media (max-width: 600px) {\n  body {padding: 1rem 0.5rem}\n  .ticket-header {flex-direction: column;align-items: flex-start;gap: 0.5rem}\n}\n</style><main>\n  <header class=\"hero\">\n    <h1 class=\"brand-title\">Slice</h1>\n    <p class=\"hero-subtitle\">去除冗余，回归本质。为对连接品质有明确要求的用户提供稳定、干净的传输通道。</p>\n    <nav class=\"hero-links\">\n      <a href=\"#plans\">查看套餐</a>\n      <a href=\"#usage\">使用说明</a>\n      <a href=\"#faq\">常见问题</a>\n    </nav>\n  </header>\n\n  <section id=\"usage\">\n    <h2>使用说明</h2>\n    <ul class=\"intro-list\">\n      <li>无需安装复杂客户端，支持市面上主流协议与第三方软件导入。</li>\n      <li>购买后获取专属订阅地址，一键复制并导入至您的终端设备。</li>\n      <li>所有节点实时状态可见，无隐藏带宽限制，按需选择对应规格。</li>\n    </ul>\n  </section>\n\n  <section id=\"plans\">\n    <h2>服务套餐</h2>\n    \n    <article class=\"ticket-card\">\n      <div class=\"ticket-header\">\n        <span class=\"plan-name\">基础版</span>\n        <span class=\"plan-price\">¥15/月</span>\n      </div>\n      <ul class=\"plan-features\">\n        <li>每月 100GB 极速流量</li>\n        <li>支持 3 台设备同时在线</li>\n        <li>解锁基础流媒体</li>\n        <li>普通线路节点池</li>\n      </ul>\n      <p class=\"annual-note\">按年付仅需 ¥150/年</p>\n      <a href=\"#plans\" class=\"btn\">选择基础版</a>\n    </article>\n\n    <article class=\"ticket-card featured\">\n      <div class=\"ticket-header\">\n        <span class=\"plan-name\">旗舰版 (推荐)</span>\n        <span class=\"plan-price\">¥35/月</span>\n      </div>\n      <ul class=\"plan-features\">\n        <li>每月 300GB 极速流量</li>\n        <li>支持 5 台设备同时在线</li>\n        <li>全节点原生流媒体解锁</li>\n        <li>IPLC 专线游戏加速优化</li>\n        <li>7x24 优先工单支持</li>\n      </ul>\n      <p class=\"annual-note\">按年付仅需 ¥350/年</p>\n      <a href=\"#plans\" class=\"btn\">选择旗舰版</a>\n    </article>\n\n    <article class=\"ticket-card\">\n      <div class=\"ticket-header\">\n        <span class=\"plan-name\">团队版</span>\n        <span class=\"plan-price\">¥85/月</span>\n      </div>\n      <ul class=\"plan-features\">\n        <li>每月 1000GB 极速流量</li>\n        <li>支持 20 台设备同时在线</li>\n        <li>VIP 专属高带宽节点</li>\n        <li>支持企业定制路由</li>\n        <li>专属客户经理服务</li>\n      </ul>\n      <p class=\"annual-note\">按年付仅需 ¥850/年</p>\n      <a href=\"#plans\" class=\"btn\">选择团队版</a>\n    </article>\n  </section>\n\n  <section id=\"faq\">\n    <h2>常见问题</h2>\n    <ol class=\"faq-list\">\n      <li class=\"faq-item\">\n        <div class=\"faq-question\">01. 如何开始使用 Slice 的服务？</div>\n        <div class=\"faq-answer\">注册账号并完成套餐订购后，您将在用户面板中获得专属订阅链接。将其复制并粘贴至您常用的兼容客户端即可完成配置。</div>\n      </li>\n      <li class=\"faq-item\">\n        <div class=\"faq-question\">02. 流量是否会在月底清空？</div>\n        <div class=\"faq-answer\">是的。所有套餐流量均按自然月周期重置，未用完的流量不会累积至下一个计费周期。</div>\n      </li>\n      <li class=\"faq-item\">\n        <div class=\"faq-question\">03. 是否支持更换或升级套餐？</div>\n        <div class=\"faq-answer\">支持。您可以随时在控制面板中选择升级或更改当前套餐，系统将自动计算差价与折算剩余时间。</div>\n      </li>\n    </ol>\n  </section>\n\n  <footer>\n    <div>© Slice. All rights reserved.</div>\n    <div><a href=\"#plans\">返回顶部</a></div>\n  </footer>\n</main>",
